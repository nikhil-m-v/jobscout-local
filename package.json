{
  "name": "jobscout-local",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/desktop"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "acceptance:preview": "node scripts/acceptance-preview.mjs",
    "dev": "node scripts/dev.mjs",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "build": "npm run build --workspace @jobscout/desktop",
    "typecheck": "npm run typecheck --workspace @jobscout/desktop",
    "test:preview": "node --experimental-strip-types --test apps/desktop/tests/search-preview.test.mjs",
    "test:criteria": "node --experimental-strip-types --test apps/desktop/tests/public-search-criteria.test.mjs",
    "test:selection": "node --experimental-strip-types --test apps/desktop/tests/resume-selection.test.mjs",
    "test:provider": "node --experimental-strip-types --test apps/desktop/tests/search-provider.test.mjs",
    "test:connection": "node --experimental-strip-types --test apps/desktop/tests/provider-connection.test.mjs",
    "engine:build": "node scripts/build-engine.mjs",
    "evaluate:shortlist": "node --experimental-strip-types scripts/evaluate-shortlist.mjs"
  }
}
